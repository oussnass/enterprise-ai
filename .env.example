APP_NAME=Enterprise AI
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
AUTH_MODE=dev
DEV_USER_ID=dev-user
DEV_USER_NAME=Development User
DEV_USER_EMAIL=dev@example.local

POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://enterprise_ai:change-me@postgres:5432/enterprise_ai

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_knowledge
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=enterprise-documents
MINIO_SECURE=false

LLM_MODE=mock
LLM_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=local-only
MODEL_NAME=Qwen/Qwen3-8B
EMBEDDING_MODEL=intfloat/multilingual-e5-small
MAX_CONTEXT_CHUNKS=6
MAX_HISTORY_MESSAGES=12

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_ENABLED=true
PIPER_MODEL_PATH=/models/piper/fr_FR-siwis-medium.onnx
PIPER_CONFIG_PATH=/models/piper/fr_FR-siwis-medium.onnx.json

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=enterprise
KEYCLOAK_CLIENT_ID=enterprise-ai
KEYCLOAK_CLIENT_SECRET=change-me
OIDC_ISSUER=http://keycloak:8080/realms/enterprise

MAX_UPLOAD_MB=500
LOG_LEVEL=INFO
